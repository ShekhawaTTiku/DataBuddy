# Copy to .env locally. Never commit real credentials.
GROQ_API_KEY=replace-with-your-key
MISTRAL_API_KEY=replace-with-your-key
GEMINI_API_KEY=replace-with-your-key

# Optional overrides (verify model access in your own provider account).
ANALYSIS_MODEL=openai/gpt-oss-120b
MEMORY_MODEL=gemini-3.5-flash-lite
MISTRAL_CHAT_MODEL=ministral-8b-latest
MISTRAL_EXPLANATION_MODEL=ministral-14b-latest
MISTRAL_FALLBACK_MODEL=ministral-14b-latest
DATABUDDY_TIMEZONE=Asia/Kolkata
DEBUG=false
ENABLE_VISUALIZATION_SUGGESTIONS=false
